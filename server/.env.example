# ==========================================
# CharacterVerse Server Environment Configuration
# ==========================================

# Port the backend server listens on
PORT=5000

# Fish Audio API Key (Get yours at https://fish.audio)
# NOTE: The app automatically falls back to an intelligent preview mode if no key is supplied,
# allowing full UI and audio experience exploration out of the box!
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here

# Fish Audio API Base URL (defaults to official API)
FISH_AUDIO_BASE_URL=https://api.fish.audio
